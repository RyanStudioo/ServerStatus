{
  "name": "serverstatus",
  "version": "0.1.0",
  "private": true,
  "description": "Server status page and Cloudflare Workers uptime API",
  "workspaces": [
    "src/client",
    "src/server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @serverstatus/server\" \"npm run dev -w @serverstatus/client\"",
    "dev:client": "npm run dev -w @serverstatus/client",
    "dev:server": "npm run dev -w @serverstatus/server",
    "build": "npm run build -w @serverstatus/client",
    "test": "npm test -w @serverstatus/server",
    "deploy:server": "npm run deploy -w @serverstatus/server",
    "db:migrate:local": "npm run db:migrate:local -w @serverstatus/server",
    "db:migrate:remote": "npm run db:migrate:remote -w @serverstatus/server"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
