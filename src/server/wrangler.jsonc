{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "serverstatus-api",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "UPTIME_WINDOW_DAYS": "28",
    "CACHE_TTL_SECONDS": "60",
    "ALLOWED_ORIGINS": "*"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "serverstatus",
      "database_id": "c8d192ca-4696-458b-85fe-da7b0abc861d"
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "0 3 * * *"]
  }
}
